{
  "name": "Branch Performance Pro v2",
  "dataColors": [
    "#1F5FBF",
    "#F2B705",
    "#0B1F3A",
    "#2E7DD7",
    "#8DB8EE",
    "#0F7C78",
    "#6A4FB3",
    "#5B6B7F"
  ],
  "good": "#1E8E3E",
  "neutral": "#808080",
  "bad": "#D93025",
  "maximum": "#1F5FBF",
  "center": "#7FA7D9",
  "minimum": "#E8EEF7",
  "background": "#FFFFFF",
  "foreground": "#1B2430",
  "tableAccent": "#0B1F3A",
  "textClasses": {
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 12,
      "color": "#1B2430"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 11,
      "color": "#1B2430"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 9,
      "color": "#5B6B7F"
    },
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 22,
      "color": "#1F3B73"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E3E8EF"
              }
            },
            "radius": 10
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "visualHeader": [
          {
            "show": true
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#1B2430"
              }
            },
            "fontSize": 12,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "padding": [
          {
            "top": 8,
            "bottom": 8,
            "left": 10,
            "right": 10
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#EEF2F7"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#EEF2F7"
              }
            }
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "header": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#F2B705"
              }
            },
            "textSize": 9
          }
        ],
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#1B2430"
              }
            },
            "textSize": 10
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColor": {
              "solid": {
                "color": "#0B1F3A"
              }
            },
            "fontSize": 9
          }
        ],
        "values": [
          {
            "fontSize": 9,
            "backColorPrimary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#F4F6FA"
              }
            }
          }
        ],
        "grid": [
          {
            "gridHorizontal": false,
            "gridVertical": false
          }
        ]
      }
    },
    "lineClusteredColumnComboChart": {
      "*": {
        "legend": [
          {
            "show": true,
            "position": "Top",
            "fontSize": 9
          }
        ],
        "valueAxis": [
          {
            "gridlineShow": false
          }
        ]
      }
    },
    "barChart": {
      "*": {
        "valueAxis": [
          {
            "show": false
          }
        ],
        "labels": [
          {
            "show": true,
            "fontSize": 9
          }
        ]
      }
    },
    "donutChart": {
      "*": {
        "legend": [
          {
            "show": true,
            "position": "Bottom",
            "fontSize": 9
          }
        ],
        "labels": [
          {
            "show": true,
            "labelStyle": "Percent of total",
            "fontSize": 9
          }
        ]
      }
    }
  }
}